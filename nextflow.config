/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/isoseq Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input           = null
    primers         = null
    rq              = 0.9
    chunk           = 40
    capped          = false
    five_prime      = 100
    splice_junction = 10
    three_prime     = 100
    aligner         = null
    min_passes      = 3
    min_snr         = 2.5
    top_passes      = 60
    min_length      = 10
    max_length      = 50000
    entrypoint      = "isoseq"

    // Reference paths (override on command line or via profiles)
    fasta_base_path   = null
    bam_base_path     = null
    primers_base_path = null

    // Toggle for large-genome resource overrides
    large_genome    = false

    // References (igenomes / server)
    genome          = null
    igenomes_base   = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore = false

    // MultiQC options
    multiqc_config              = null
    multiqc_title               = null
    multiqc_logo                = null
    max_multiqc_email_size      = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    version                      = false

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'

    // Schema validation default options
    validationFailUnrecognisedParams = false
    validationLenientMode            = false
    validationShowHiddenParams       = false
    validate_params                  = true

}

// nf-schema 2.x validation config (replaces legacy params.validationSchemaIgnoreParams)
// "genomes" prefix-matches all nested keys: genomes.GRCh38.fasta, genomes.hg38.bwa, etc.
validation {
    ignoreParams = ["genomes"]
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load nf-core/isoseq custom profiles from different institutions.
// Warning: Uncomment only if a pipeline-specific institutional config already exists on nf-core/configs!
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/isoseq.config" : "/dev/null"

// Load modules.config for DSL2 module specific options (before profiles to allow profile overrides)
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
        docker.fixOwnership     = true
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
    }
    test                         { includeConfig 'conf/test.config'                         }
    test_full                    { includeConfig 'conf/test_full.config'                    }
    test_local                   { includeConfig 'conf/test_local.config'                   }
    test_minimap2                { includeConfig 'conf/test_minimap2.config'                }
    test_minimap2_local          { includeConfig 'conf/test_minimap2_local.config'          }
    test_minimap2_map_entrypoint         { includeConfig 'conf/test_minimap2_map_entrypoint.config'         }
    test_minimap2_map_entrypoint_local   { includeConfig 'conf/test_minimap2_map_entrypoint_local.config'   }
    test_lima_entrypoint                 { includeConfig 'conf/test_lima_entrypoint.config'                 }
    test_lima_entrypoint_local           { includeConfig 'conf/test_lima_entrypoint_local.config'           }
    test_isoseq3_refine_entrypoint       { includeConfig 'conf/test_isoseq3_refine_entrypoint.config'       }
    test_isoseq3_refine_entrypoint_local { includeConfig 'conf/test_isoseq3_refine_entrypoint_local.config' }
    test_bamtools_convert_entrypoint       { includeConfig 'conf/test_bamtools_convert_entrypoint.config'       }
    test_bamtools_convert_entrypoint_local { includeConfig 'conf/test_bamtools_convert_entrypoint_local.config' }
    test_ultra_map_entrypoint             { includeConfig 'conf/test_ultra_map_entrypoint.config'             }
    test_ultra_map_entrypoint_local       { includeConfig 'conf/test_ultra_map_entrypoint_local.config'       }
    test_ultra_lima_entrypoint            { includeConfig 'conf/test_ultra_lima_entrypoint.config'            }
    test_ultra_lima_entrypoint_local      { includeConfig 'conf/test_ultra_lima_entrypoint_local.config'      }
    test_ultra_isoseq3_refine_entrypoint  { includeConfig 'conf/test_ultra_isoseq3_refine_entrypoint.config'  }
    test_ultra_isoseq3_refine_entrypoint_local { includeConfig 'conf/test_ultra_isoseq3_refine_entrypoint_local.config' }
    test_ultra_bamtools_convert_entrypoint{ includeConfig 'conf/test_ultra_bamtools_convert_entrypoint.config'}
    test_ultra_bamtools_convert_entrypoint_local { includeConfig 'conf/test_ultra_bamtools_convert_entrypoint_local.config' }
    server        { includeConfig 'conf/server.config'                       }
    large_genome  { includeConfig 'conf/large_genome.config'                 }
    server_large_genome {
        includeConfig 'conf/server.config'
        includeConfig 'conf/large_genome.config'
    }
}

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'
// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.html"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/isoseq'
    author          = """SiYangming"""
    homePage        = 'https://github.com/SiYangming/isoseq.nf'
    description     = """Genes and transcripts annotation with Isoseq using uLTRA and TAMA"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.8'
    version         = '3.0.1'
    doi             = '10.5281/zenodo.7116979'
}

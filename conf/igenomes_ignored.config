/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub genomes map used when --igenomes_ignore is set.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    When params.igenomes_ignore = true, the pipeline should not load the
    iGenomes registry. This file provides an empty genomes map so that
    getGenomeAttribute() returns null and genomeExistsError() passes
    silently (because params.genomes is empty).
----------------------------------------------------------------------------------------
*/

params {
    genomes = [:]
}

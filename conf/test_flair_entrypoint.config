/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal FLAIR entrypoint tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/isoseq -profile test_flair_entrypoint,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile - FLAIR entrypoint'
    config_profile_description = 'Minimal test dataset to check flair entrypoint function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data: full-length transcript reads derived from alz.isoseq_refine.bam (BAM -> FASTQ)
    input           = "${launchDir}/samplesheets/test_flair_entrypoint.csv"
    primers         = "${launchDir}/testdata/primers.fasta"
    fasta           = "${launchDir}/testdata/reference/Homo_sapiens.GRCh38.dna.chromosome.19.fasta"
    gtf             = "${launchDir}/testdata/reference/Homo_sapiens.GRCh38.104.chr.13_18_19.gtf"

    entrypoint      = 'flair'
    aligner         = 'minimap2' // 仅用于通过 schema 校验，flair 分支不读取
}

// Override process resource limits for local execution specifically
process {
    withLabel:process_high {
        cpus   = { 2                   }
        memory = { 6.GB * task.attempt }
    }
}

docker {
    runOptions = '--platform linux/amd64'
}

// Overwrite trace/report files to avoid warnings on re-runs
trace.overwrite    = true
report.overwrite   = true
timeline.overwrite = true

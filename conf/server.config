/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the isoseq pipeline on a production server
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines:
        - Reference base path on the server (PublicDB/reference)
        - Genome-specific FASTA / GTF / primer paths (params.genomes map)
        - Global executor resource limits
        - Per-process resource and parameter overrides
        - Container engine (Docker) configuration

    Usage:
        nextflow run main.nf -profile server \
            --genome Arabidopsis_thaliana \
            --input samplesheets/Arabidopsis_thaliana_TAIR10_isoseq.csv \
            --outdir /data1/users/siyangming/isoseq_results/Arabidopsis_thaliana

    Large genomes (e.g. Triticum_aestivum):
        nextflow run main.nf -profile server_large_genome \
            --genome Triticum_aestivum \
            --input samplesheets/test_online.csv \
            --outdir /data1/users/siyangming/isoseq_results/Triticum_aestivum

    T6 数据集（Oryza sativa 长读长，ULTRA + isoseq3_refine）：
        个性化参数（input/outdir/aligner/entrypoint/primers/chunk 等）通过命令行指定，
        基因组 fasta/gtf 由 --genome Oryza_sativa 从下方 genomes map 解析。
        nextflow run main.nf -profile server,docker \
            --genome Oryza_sativa \
            --input samplesheets/T6.csv \
            --outdir /data1/users/siyangming/osa_Japonica_long_read/T6/results_T6 \
            --primers ${projectDir}/primers/Kinnex-full-length-RNA/REF-primers/IsoSeq_v2_primers_12.fasta \
            --aligner ultra --entrypoint isoseq3_refine \
            --chunk 40 --five_prime 100 --splice_junction 10 --three_prime 100 --capped false
----------------------------------------------------------------------------------------
*/

params {

    // Resource upper bounds
    max_memory = '256 GB'
    max_cpus   = 64
    max_time   = '72.h'

    // Server identity
    config_profile_name        = 'Server profile'
    config_profile_description = 'Production configuration for isoseq pipeline (128 CPUs / 503GB memory server)'

    // 参考基因组根目录 —— 服务器实际数据位于 PublicDB/reference（见 /data1/users/siyangming/PublicDB/directory_structure.txt）
    // 结构：/data1/users/siyangming/PublicDB/reference/{Species}/{Species}.{Build}.dna.fa.gz
    fasta_base_path = "/data1/users/siyangming/PublicDB/reference"

    // subreads / CCS BAM 基础路径（仅作约定，实际路径以 --input samplesheet 为准）
    bam_base_path   = "/data1/users/siyangming/isoSeq/BAM"

    // primers 基础路径 —— 服务器上无 isoSeq/primers 目录，使用仓库自带 primer 文件。
    // 可选文件：
    //   ${projectDir}/primers/REV-Kinnex-ISO/primers.fasta
    //   ${projectDir}/primers/Kinnex-full-length-RNA/REF-primers/IsoSeq_v2_primers_12.fasta
    //   ${projectDir}/primers/Kinnex-full-length-RNA/MAS_adapters/MAS-Seq_Adapter_v1/mas16_primers.fasta
    //   ${projectDir}/primers/Kinnex-full-length-RNA/MAS_adapters/MAS-Seq_Adapter_v2/mas12_primers.fasta
    //   ${projectDir}/primers/Kinnex-full-length-RNA/MAS_adapters/MAS-Seq_Adapter_v3/mas8_primers.fasta
    primers_base_path = "${projectDir}/primers"

    // 默认 primer 文件：不同实验方案（Kinnex MAS / REV-Kinnex-ISO / Iso-Seq v2）使用不同 adapter，
    // 必须按实验显式指定：--primers ${params.primers_base_path}/REV-Kinnex-ISO/primers.fasta
    primers = null

    // Default entrypoint (override per-run with --entrypoint isoseq|lima|isoseq3_refine|bamtools_convert|map)
    entrypoint = 'lima'

    // Default aligner (override with --aligner minimap2|ultra)
    aligner   = 'minimap2'

    // Genome registry：key 对应 --genome；路径基于 ${params.fasta_base_path} 拼接。
    // 仅收录服务器上实际存在的物种（参考 /data1/users/siyangming/PublicDB/directory_structure.txt）。
    // GTF 仅为 uLTRA 比对器所需（minimap2 仅需 FASTA）；无 GTF 的物种仅支持 minimap2。
    genomes {

        'Alopecurus_myosuroides' {
            fasta   = "${params.fasta_base_path}/Alopecurus_myosuroides/Alopecurus_myosuroides_v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Amaranthus_palmeri_hap1' {
            fasta   = "${params.fasta_base_path}/Amaranthus_palmeri/Amaranthus_palmeri_hap1_v01.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Amaranthus_palmeri_hap2' {
            fasta   = "${params.fasta_base_path}/Amaranthus_palmeri/Amaranthus_palmeri_hap2_v01.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Arabidopsis_thaliana' {
            fasta   = "${params.fasta_base_path}/Arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Arabidopsis_thaliana/Arabidopsis_thaliana.TAIR10.63.gtf.gz"
        }

        'Artemisia_annua' {
            fasta   = "${params.fasta_base_path}/Artemisia_annua/Artemisia_annua_v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Beta_vulgaris' {
            fasta   = "${params.fasta_base_path}/Beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Beta_vulgaris/Beta_vulgaris.RefBeet-1.2.2.63.gtf.gz"
        }

        'Boehmeria_nivea' {
            fasta   = "${params.fasta_base_path}/Boehmeria_nivea/Boehmeria_nivea_v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Camelina_sativa' {
            fasta   = "${params.fasta_base_path}/Camelina_sativa/Camelina_sativa.Cs.dna.fa.gz"
            gtf     = null // 仅 GFF3 注释 → 仅支持 minimap2
        }

        'Cryptomeria_japonica' {
            fasta   = "${params.fasta_base_path}/Cryptomeria_japonica/Cryptomeria_japonica_1.0.fa.gz"
            gtf     = "${params.fasta_base_path}/Cryptomeria_japonica/GCF_030272615.1_Sugi_1.0_genomic.gtf.gz"
        }

        'Cynodon_dactylon' {
            fasta   = "${params.fasta_base_path}/Cynodon_dactylon/Cynodon_dactylon_ASM4686236v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Daucus_carota' {
            fasta   = "${params.fasta_base_path}/Daucus_carota/Daucus_carota.ASM162521v1.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Daucus_carota/Daucus_carota.ASM162521v1.63.gtf.gz"
        }

        'Dendrobium_catenatum' {
            fasta   = "${params.fasta_base_path}/Dendrobium_catenatum/Dendrobium_catenatum_v2.fa.gz"
            gtf     = "${params.fasta_base_path}/Dendrobium_catenatum/GCF_001605985.2_ASM160598v2_genomic.gtf.gz"
        }

        'Helianthus_annuus' {
            fasta   = "${params.fasta_base_path}/Helianthus_annuus/Helianthus_annuus.HanXRQr2.0-SUNRISE.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Helianthus_annuus/Helianthus_annuus.HanXRQr2.0-SUNRISE.63.gtf.gz"
        }

        'Lactuca_sativa' {
            fasta   = "${params.fasta_base_path}/Lactuca_sativa/Lactuca_sativa_gca002870075v4gb.Lsat_Salinas_v11.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Lactuca_sativa/Lactuca_sativa_gca002870075v4gb.Lsat_Salinas_v11.63.gtf.gz"
        }

        'Lycium_ruthenicum' {
            fasta   = "${params.fasta_base_path}/Lycium_ruthenicum/Lycium_ruthenicum_ASM4143038v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Medicago_truncatula' {
            fasta   = "${params.fasta_base_path}/Medicago_truncatula/Medicago_truncatula.MtrunA17r5.0_ANR.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Medicago_truncatula/Medicago_truncatula.MtrunA17r5.0_ANR.63.gtf.gz"
        }

        'Nicotiana_benthamiana' {
            fasta   = "${params.fasta_base_path}/Nicotiana_benthamiana/Nicotiana_benthamiana_v1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Oryza_rufipogon' {
            fasta   = "${params.fasta_base_path}/Oryza_rufipogon/Oryza_rufipogon.OR_W1943.dna.toplevel.fa.gz"
            gtf     = null // 仅 GFF3 注释 → 仅支持 minimap2
        }

        'Oryza_sativa' {
            fasta   = "${params.fasta_base_path}/Oryza_sativa/Oryza_sativa.IRGSP-1.0.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Oryza_sativa/Oryza_sativa.IRGSP-1.0.63.gtf.gz"
        }

        'Pinellia_ternata' {
            fasta   = "${params.fasta_base_path}/Pinellia_ternata/Pinellia_ternata_v1.fa.gz"
            gtf     = null // 仅 GFF 注释 → 仅支持 minimap2
        }

        'Solanum_lycopersicum' {
            fasta   = "${params.fasta_base_path}/Solanum_lycopersicum/Solanum_lycopersicum_gca000188115v5cm.SL4.0.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Solanum_lycopersicum/Solanum_lycopersicum_gca000188115v5cm.SL4.0.63.gtf.gz"
        }

        'Spirodela_polyrhiza' {
            fasta   = "${params.fasta_base_path}/Spirodela_polyrhiza/Spirodela_polyrhiza_v2.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Tragopogon_porrifolius_hap1' {
            fasta   = "${params.fasta_base_path}/Tragopogon_porrifolius/Tragopogon_porrifolius_hap1.1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Tragopogon_porrifolius_hap2' {
            fasta   = "${params.fasta_base_path}/Tragopogon_porrifolius/Tragopogon_porrifolius_hap2.1.fa.gz"
            gtf     = null // 服务器无 GTF → 仅支持 minimap2
        }

        'Trifolium_pratense' {
            fasta   = "${params.fasta_base_path}/Trifolium_pratense/Trifolium_pratense.Trpr.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Trifolium_pratense/Trifolium_pratense.Trpr.63.gtf.gz"
        }

        'Triticum_aestivum' {
            fasta   = "${params.fasta_base_path}/Triticum_aestivum/Triticum_aestivum.IWGSC.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Triticum_aestivum/Triticum_aestivum.IWGSC.63.gtf.gz"
        }

        'Vitis_vinifera' {
            fasta   = "${params.fasta_base_path}/Vitis_vinifera/Vitis_vinifera.ASM3070453v1.dna.fa.gz"
            gtf     = "${params.fasta_base_path}/Vitis_vinifera/Vitis_vinifera.ASM3070453v1.63.gtf.gz"
        }
    }
}

// =========================================================================
// Global executor — server has 128 CPUs / 503 GB memory.
// Keep 32 cores and ~100 GB free for system/other users.
// =========================================================================
executor {
    name       = 'local'
    cpus       = 96
    memory     = '400 GB'
    queueSize  = 20
}

process {
    executor = 'local'

    // ---- Preprocessing (entrypoint=isoseq) ---------------------------------
    withName: 'PBCCS' {
        memory   = '32 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'PICARD_SPLITSAMBYNUMBEROFREADS' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'PICARD_FILENAME' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    withName: 'LIMA' {
        memory   = '32 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'ISOSEQ_REFINE' {
        memory   = '32 GB'
        cpus     = 8
        time     = '12.h'
    }

    withName: 'BAMTOOLS_CONVERT' {
        memory   = '8 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_POLYACLEANUP' {
        memory   = '8 GB'
        cpus     = 4
        time     = '4.h'
    }

    // ---- Alignment --------------------------------------------------------
    withName: 'MINIMAP2_ALIGN' {
        memory   = '64 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'ULTRA_INDEX' {
        memory   = '64 GB'
        cpus     = 16
        time     = '12.h'
    }

    withName: 'ULTRA_ALIGN' {
        memory   = '64 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'GNU_SORT' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GUNZIP' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    // ---- TAMA collapse / merge -------------------------------------------
    withName: 'GSTAMA_COLLAPSE' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_MERGE' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_FILELIST' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    // ---- Reporting --------------------------------------------------------
    withName: 'MULTIQC' {
        memory   = '32 GB'
        cpus     = 8
        time     = '8.h'
    }
}

// Container engine — Docker only on this server
singularity {
    enabled = false
}

docker {
    enabled = true
}

conda {
    enabled = false
}

// Reports overwrite to avoid warnings on resume
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/timeline.html"
}

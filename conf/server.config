/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the isoseq pipeline on a production server
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines:
        - FASTA base path on the server
        - Genome-specific FASTA / GTF / primer paths (params.genomes map)
        - Global executor resource limits
        - Per-process resource and parameter overrides
        - Container engine (Docker) configuration

    Usage:
        nextflow run main.nf -profile server \
            --genome GRCh38 \
            --input samplesheets/Homo_sapiens_GRCh38_isoseq.csv \
            --outdir /data1/users/siyangming/isoseq_results/Homo_sapiens

    Large genomes (e.g. susScr3, bosTau8):
        nextflow run main.nf -profile server -c conf/large_genome.config \
            --genome susScr3 \
            --input samplesheets/samplesheet.csv \
            --outdir /data1/users/siyangming/isoseq_results/Sus_scrofa
----------------------------------------------------------------------------------------
*/

params {

    // Resource upper bounds
    max_memory = '256 GB'
    max_cpus   = 64
    max_time   = '72.h'

    // Server identity
    config_profile_name        = 'Server profile'
    config_profile_description = 'Production configuration for isoseq pipeline (128 CPUs / 503GB memory server)'

    // FASTA / BAM / annotation base directories on the server
    fasta_base_path = "/data1/users/siyangming/FASTA"
    bam_base_path   = "/data1/users/siyangming/isoSeq/BAM"
    primers_base_path = "/data1/users/siyangming/isoSeq/primers"

    // Default primer file (full-length isoform primers used by LIMA)
    // Override per-run with --primers /path/to/primers.fasta
    primers = null

    // Default entrypoint (override per-run with --entrypoint isoseq|lima|isoseq3_refine|bamtools_convert|map)
    entrypoint = 'lima'

    // Default aligner (override with --aligner minimap2|ultra)
    aligner   = 'minimap2'

    // igenomes-style genome registry. All paths are resolved relative to fasta_base_path
    // unless a full absolute path is supplied. Override per-run with --fasta /path/to/genome.fa.
    genomes {

        'GRCh38' {
            fasta   = "${params.fasta_base_path}/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Homo_sapiens/NCBI/GRCh38/Annotation/Genes/genes.gtf"
        }
        'GRCh37' {
            fasta   = "${params.fasta_base_path}/Homo_sapiens/Ensembl/GRCh37/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Homo_sapiens/Ensembl/GRCh37/Annotation/Genes/genes.gtf"
        }
        'hg38' {
            fasta   = "${params.fasta_base_path}/Homo_sapiens/UCSC/hg38/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Homo_sapiens/UCSC/hg38/Annotation/Genes/genes.gtf"
        }
        'hg19' {
            fasta   = "${params.fasta_base_path}/Homo_sapiens/UCSC/hg19/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Homo_sapiens/UCSC/hg19/Annotation/Genes/genes.gtf"
        }
        'mm10' {
            fasta   = "${params.fasta_base_path}/Mus_musculus/UCSC/mm10/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Mus_musculus/UCSC/mm10/Annotation/Genes/genes.gtf"
        }
        'TAIR10' {
            fasta   = "${params.fasta_base_path}/Arabidopsis_thaliana/Ensembl/TAIR10/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Arabidopsis_thaliana/Ensembl/TAIR10/Annotation/Genes/genes.gtf"
        }
        'IRGSP-1.0' {
            fasta   = "${params.fasta_base_path}/Oryza_sativa_japonica/Ensembl/IRGSP-1.0/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Oryza_sativa_japonica/Ensembl/IRGSP-1.0/Annotation/Genes/genes.gtf"
        }
        'Sscrofa10.2' {
            fasta   = "${params.fasta_base_path}/Sus_scrofa/Ensembl/Sscrofa10.2/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Sus_scrofa/Ensembl/Sscrofa10.2/Annotation/Genes/genes.gtf"
        }
        'susScr3' {
            fasta   = "${params.fasta_base_path}/Sus_scrofa/UCSC/susScr3/Sequence/WholeGenomeFasta/genome.fa"
            gtf     = "${params.fasta_base_path}/Sus_scrofa/UCSC/susScr3/Annotation/Genes/genes.gtf"
        }
    }
}

// =========================================================================
// Global executor — server has 128 CPUs / 503 GB memory.
// Keep 32 cores and ~100 GB free for system/other users.
// =========================================================================
executor {
    name       = 'local'
    cpus       = 96
    memory     = '400 GB'
    queueSize  = 20
}

process {
    executor = 'local'

    // ---- Preprocessing (entrypoint=isoseq) ---------------------------------
    withName: 'PBCCS' {
        memory   = '32 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'PICARD_SPLITSAMBYNUMBEROFREADS' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'PICARD_FILENAME' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    withName: 'LIMA' {
        memory   = '32 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'ISOSEQ_REFINE' {
        memory   = '32 GB'
        cpus     = 8
        time     = '12.h'
    }

    withName: 'BAMTOOLS_CONVERT' {
        memory   = '8 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_POLYACLEANUP' {
        memory   = '8 GB'
        cpus     = 4
        time     = '4.h'
    }

    // ---- Alignment --------------------------------------------------------
    withName: 'MINIMAP2_ALIGN' {
        memory   = '64 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'ULTRA_INDEX' {
        memory   = '64 GB'
        cpus     = 16
        time     = '12.h'
    }

    withName: 'ULTRA_ALIGN' {
        memory   = '64 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'GNU_SORT' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GUNZIP' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    // ---- TAMA collapse / merge -------------------------------------------
    withName: 'GSTAMA_COLLAPSE' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_MERGE' {
        memory   = '16 GB'
        cpus     = 4
        time     = '4.h'
    }

    withName: 'GSTAMA_FILELIST' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        memory   = '4 GB'
        cpus     = 1
        time     = '1.h'
    }
}

// Container engine — Docker only on this server
singularity {
    enabled = false
}

docker {
    enabled      = true
    fixOwnership = true
    runOptions   = '-u $(id -u):$(id -g)'
}

conda {
    enabled = false
}

// Reports overwrite to avoid warnings on resume
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/reports/timeline.html"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for large genomes (susScr3, bosTau8, Triticum_aestivum, ...)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Increases memory and time limits for the alignment / indexing stages.
    Use together with -profile server, e.g.:

        nextflow run main.nf -profile server -c conf/large_genome.config \
            --genome susScr3 \
            --input samplesheets/test_online.csv \
            --outdir /data1/users/siyangming/isoseq_results/Sus_scrofa

    This config is layered AFTER conf/server.config so its withName values
    override the same fields from the server profile.
----------------------------------------------------------------------------------------
*/

params {
    large_genome = true
}

process {

    // Alignment
    withName: 'MINIMAP2_ALIGN' {
        memory   = '128 GB'
        cpus     = 32
        time     = '48.h'
    }

    withName: 'ULTRA_INDEX' {
        memory   = '128 GB'
        cpus     = 32
        time     = '24.h'
    }

    withName: 'ULTRA_ALIGN' {
        memory   = '128 GB'
        cpus     = 32
        time     = '48.h'
    }

    // Preprocessing (PBCCS / LIMA) can also be slow on large genomes
    withName: 'PBCCS' {
        memory   = '64 GB'
        cpus     = 32
        time     = '48.h'
    }

    withName: 'LIMA' {
        memory   = '64 GB'
        cpus     = 32
        time     = '48.h'
    }

    withName: 'ISOSEQ_REFINE' {
        memory   = '64 GB'
        cpus     = 16
        time     = '24.h'
    }

    withName: 'GSTAMA_COLLAPSE' {
        memory   = '32 GB'
        cpus     = 8
        time     = '8.h'
    }

    withName: 'GSTAMA_MERGE' {
        memory   = '32 GB'
        cpus     = 8
        time     = '8.h'
    }
}

/*
 * Minimal PBCCS compatibility override for old SMRT Analysis 4.0 BAMs.
 *
 * The default PBCCS module and its ccs container are unchanged. This config
 * only tells pbbam to resolve the old BAM header combination below to
 * S/P2-C2/5.0.
 */
process {
    withName: 'PBCCS' {
        containerOptions = "-e SMRT_CHEMISTRY_BUNDLE_DIR='${projectDir}/conf/pbccs-chem-bundle'"
    }
}
